 				$(APSOC_COMMON)/bl31/mtk_boot_next.c		\
@@ -28,6 +28,7 @@ BL31_SOURCES		+=	drivers/arm/cci/cci.c				\
 				$(APSOC_COMMON)/bl31/plat_topology.c		\
