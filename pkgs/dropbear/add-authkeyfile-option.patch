 	opts.compression = 1;
-#endif 
+#endif
 
 	/* not yet
 	opts.ipv4 = 1;
@@ -362,6 +364,9 @@ void svr_getopts(int argc, char ** argv) {
 				case 'u':
 					/* backwards compatibility with old urandom option */
 					break;
+				case 'U':
+					next = &authkeysfile;
+					break;
 #if DROPBEAR_PLUGIN
                                 case 'A':
                                         next = &pubkey_plugin;
@@ -412,6 +417,10 @@ void svr_getopts(int argc, char ** argv) {
 				addhostkey(keyfile);
 				keyfile = NULL;
 			}
+			if (authkeysfile) {
+				svr_opts.authorized_keys_file = m_strdup(authkeysfile);
+				authkeysfile = NULL;
+			}
 		}
 	}
 
